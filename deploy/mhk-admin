#!/bin/sh
# Sysadmin CLI on the production host (run as root): `mhk-server admin` inside the running server container, with its
# database and data directory, e.g. `mhk-admin account set-role alice moderator`.
set -eu
exec docker compose -f /srv/mhk-os/deploy/compose.yml exec server /usr/local/bin/mhk-server admin "$@"
