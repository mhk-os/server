# /etc/mhk-server/env (root:mhk-server, mode 0640). Read by mhk-server.service and mhk-admin.
MHK_DB_DSN=mhk:CHANGE_ME@tcp(127.0.0.1:3306)/mhk?parseTime=true
MHK_LISTEN=:7350
MHK_UDP_LISTEN=:7350
MHK_TLS_CERT=/etc/mhk-server/tls/fullchain.pem
MHK_TLS_KEY=/etc/mhk-server/tls/privkey.pem
MHK_DATA_DIR=/var/lib/mhk-server/data
MHK_GEOIP=/var/lib/mhk-server/geoip/dbip-country-lite.mmdb
MHK_LOG_LEVEL=info
